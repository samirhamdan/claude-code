# === Domínio ===
# DOMAIN completo (usado pelo n8n e Caddy)
DOMAIN=sdr.duckdns.org
# SUBDOMAIN é só a parte antes de ".duckdns.org" (usado pelo container do DuckDNS)
SUBDOMAIN=sdr
DUCKDNS_TOKEN=seu-token-aqui

# === Postgres ===
POSTGRES_USER=alessio
POSTGRES_PASSWORD=troque-por-senha-forte
POSTGRES_DB=n8n

# === n8n ===
N8N_ENCRYPTION_KEY=gere-com-openssl-rand-hex-32
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque-por-senha-forte

# === Telegram ===
TELEGRAM_BOT_TOKEN=123456:ABC-seu-token

# === Anthropic ===
ANTHROPIC_API_KEY=sk-ant-sua-chave
